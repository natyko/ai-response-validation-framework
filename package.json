{
  "name": "ai-response-validation-framework",
  "version": "1.0.0",
  "description": "Reusable framework for validating AI-generated responses in mobile and healthcare-style applications.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "validate:sample": "tsx src/cli/validate.ts examples/responses/sample-response.json",
    "review:testcases": "tsx src/cli/review-test-cases.ts examples/test-cases/ai-generated-test-cases.json",
    "ci:report": "npm run ci:build && npm run ci:test && npm run ci:validate && npm run ci:review",
    "ci:build": "npm run build",
    "ci:test": "npm test",
    "ci:validate": "npm run validate:sample",
    "ci:review": "npm run review:testcases"
  },
  "keywords": [
    "ai-testing",
    "quality-engineering",
    "qa-automation",
    "healthcare-technology",
    "response-validation",
    "regression-testing",
    "mobile-testing"
  ],
  "author": "Natalia Kozitcyna",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "tsx": "^4.22.3",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
